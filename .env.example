GMAIL_QUERY=from:mailoffice@nkust.edu.tw
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_TIMEOUT_SECONDS=30
DATABASE_PATH=data/nkust_mail.db
AI_PROVIDER=iai
AI_BASE_URL=https://www.iai.nkust.edu.tw/aihub/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
SCRAPE_ALLOWED_HOSTS=officemail.nkust.edu.tw

# Multi-user database: MUST differ from DATABASE_PATH. No automatic fallback.
# Example: sqlite:///data/nkust_multi_user.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST/NEW_DATABASE
DATABASE_URL=
# Web OAuth (app.web); not consumed by the legacy application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# CSRF secret for DB-backed sessions; setup_local generates it once if absent.
SESSION_SECRET=
# Fernet key; generate once with: python -m app.auth.setup_local
# Keep this key: replacing it makes existing encrypted tokens unreadable.
TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=
